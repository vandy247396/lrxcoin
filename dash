 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>Liberty Reserve | LRX Staking Platform</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"></script>
  <style>
    * { -webkit-tap-highlight-color: transparent; }
    body { background: linear-gradient(145deg, #f1f5f9 0%, #e9eef5 100%); font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif; }
    .glass-card { transition: all 0.2s ease; }
    .glass-card:hover { transform: translateY(-3px); box-shadow: 0 20px 30px -12px rgba(0,0,0,0.15); }
    .fade-in { animation: fadeSlide 0.3s ease-out; }
    @keyframes fadeSlide { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    .toast-slide { animation: slideUp 0.25s ease forwards; }
    @keyframes slideUp { from { opacity:0; transform:translate(-50%,20px); } to { opacity:1; transform:translate(-50%,0); } }
    .tab-active { background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: white; border-bottom: 3px solid white; }
    .tab-inactive { background: rgba(255,255,255,0.6); color: #4b5563; }
    .loading-spinner {
      display: inline-block; width: 20px; height: 20px;
      border: 2px solid rgba(255,255,255,0.3); border-radius: 50%;
      border-top-color: white; animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    @media (max-width: 768px) { .glass-card:hover { transform: none; } table { font-size: 12px; } }
    .stat-card { transition: all 0.3s ease; }
    .stat-card:hover { transform: translateY(-5px); }
    .withdraw-btn {
      background: linear-gradient(135deg, #10b981, #059669);
      animation: pulse 2s infinite;
    }
    .withdraw-btn:disabled {
      background: #9ca3af !important;
      animation: none !important;
      cursor: not-allowed;
    }
    @keyframes pulse {
      0%   { box-shadow: 0 0 0 0 rgba(16,185,129,0.5); }
      70%  { box-shadow: 0 0 0 12px rgba(16,185,129,0); }
      100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }
    }
  </style>
</head>
<body class="p-3 md:p-6">
<div class="max-w-7xl mx-auto">

  <!-- HEADER -->
  <div class="flex flex-wrap justify-between items-center mb-6 pb-2 border-b border-gray-200/70 gap-3">
    <div class="flex items-center gap-3">
      <div class="bg-gradient-to-br from-blue-600 to-indigo-700 w-10 h-10 md:w-11 md:h-11 rounded-2xl flex items-center justify-center shadow-lg">
        <span class="text-white font-black text-xl md:text-2xl">L</span>
      </div>
      <div>
        <h1 class="text-xl md:text-3xl font-extrabold bg-gradient-to-r from-blue-800 to-indigo-800 bg-clip-text text-transparent">Liberty Reserve</h1>
        <p class="text-xs text-gray-500 hidden sm:block">LRX Staking &bull; 150 Days &bull; 1.33% Daily &bull; Polygon</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <a href="https://polygonscan.com/address/0x6530c53B10E49cbf76a59aB60A1170b91D1Bd02D"
         target="_blank" rel="noopener noreferrer"
         class="text-xs bg-white/80 border border-purple-200 text-purple-700 px-3 py-1 rounded-full shadow-sm hover:bg-purple-50 transition flex items-center gap-1">
        <i class="fas fa-shield-alt" style="font-size:10px"></i>
        <span class="hidden sm:inline">Verified Contract</span>
        <i class="fas fa-external-link-alt" style="font-size:9px"></i>
      </a>
      <div class="text-xs bg-white/60 px-3 py-1 rounded-full shadow-sm">
        <i class="fas fa-circle text-green-500 mr-1" style="font-size:8px"></i> Polygon
      </div>
      <button id="connectBtn" onclick="connectWallet()"
        class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-3 md:px-4 py-2 rounded-full text-xs md:text-sm font-semibold shadow-lg hover:shadow-xl transition whitespace-nowrap">
        <i class="fab fa-metamask mr-1 md:mr-2"></i><span class="hidden sm:inline">Connect Wallet</span><span class="sm:hidden">Connect</span>
      </button>
    </div>
  </div>

  <!-- DASHBOARD -->
  <div id="dashboardPanel" class="hidden fade-in">

    <!-- TOP STATS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 mb-6">
      <div class="bg-white rounded-2xl shadow-lg p-3 md:p-4 border border-blue-100 stat-card">
        <p class="text-blue-500 text-xs font-semibold">WALLET ADDRESS</p>
        <p class="text-xs md:text-sm font-mono font-bold truncate" id="walletAddr">—</p>
        <p class="text-xs text-gray-400 mt-1">LRX Balance: <span id="lrxBal" class="font-bold text-purple-600">0.00</span></p>
      </div>
      <div class="bg-gradient-to-r from-purple-600 to-indigo-600 rounded-2xl shadow-lg p-3 md:p-4 text-white stat-card">
        <p class="text-purple-200 text-xs font-semibold">💰 TOTAL STAKED</p>
        <p class="text-xl md:text-2xl font-extrabold"><span id="totalStakedAmount">0.00</span> LRX</p>
        <p class="text-xs text-purple-200 mt-1">Across all your stakes</p>
      </div>
      <div class="bg-gradient-to-r from-green-600 to-emerald-600 rounded-2xl shadow-lg p-3 md:p-4 text-white stat-card">
        <p class="text-green-200 text-xs font-semibold">🌱 TOTAL GROWTH AVAILABLE</p>
        <p class="text-xl md:text-2xl font-extrabold"><span id="totalPendingGrowth">0.00</span> LRX</p>
        <p class="text-xs text-green-200 mt-1">All stakes combined &bull; Starts Day 2</p>
      </div>
      <div class="bg-gradient-to-r from-amber-500 to-orange-500 rounded-2xl shadow-lg p-3 md:p-4 text-white stat-card">
        <p class="text-amber-100 text-xs font-semibold">📈 DAILY GROWTH RATE</p>
        <p class="text-xl md:text-2xl font-extrabold"><span id="dailyGrowthTotal">0.00</span> LRX</p>
        <p class="text-xs text-amber-100 mt-1">Per day &bull; 1.33% of staked total</p>
      </div>
    </div>

    <!-- TABS -->
    <div class="flex gap-2 mb-6 overflow-x-auto pb-1">
      <button onclick="showTab('staking')" id="tabStakingBtn" class="tab-active px-4 md:px-6 py-2 rounded-t-xl font-semibold transition-all whitespace-nowrap">💰 Staking</button>
      <button onclick="showTab('history')" id="tabHistoryBtn" class="tab-inactive px-4 md:px-6 py-2 rounded-t-xl font-semibold transition-all whitespace-nowrap">📜 Withdrawal History</button>
    </div>

    <!-- STAKING TAB -->
    <div id="stakingTab" class="fade-in">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- LEFT COLUMN -->
        <div class="space-y-6">

          <!-- ★ COMBINED GROWTH WITHDRAWAL CARD ★ -->
          <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl shadow-xl p-5 border-2 border-green-200">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-9 h-9 bg-green-500 rounded-xl flex items-center justify-center shadow">
                <i class="fas fa-seedling text-white"></i>
              </div>
              <div>
                <h3 class="text-lg font-bold text-green-800">Your Growth Balance</h3>
                <p class="text-xs text-green-600">All stakes combined &bull; Withdraw anytime when ≥ 100 LRX</p>
              </div>
            </div>

            <!-- Big number -->
            <div class="bg-white rounded-2xl p-5 mb-4 text-center shadow-inner">
              <p class="text-xs text-gray-400 mb-1 uppercase tracking-widest">Total Growth Available</p>
              <p class="text-5xl font-black text-green-600" id="bigGrowthNumber">0.0000</p>
              <p class="text-sm text-gray-400 mt-1">LRX</p>

              <!-- Progress bar -->
              <div class="mt-4">
                <div class="flex justify-between text-xs text-gray-400 mb-1">
                  <span>Progress to 100 LRX withdrawal minimum</span>
                  <span id="progressPct">0%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-3">
                  <div id="progressBar" class="bg-gradient-to-r from-green-400 to-emerald-500 h-3 rounded-full transition-all duration-700" style="width:0%"></div>
                </div>
              </div>

              <!-- Breakdown boxes -->
              <div class="mt-4 grid grid-cols-2 gap-2 text-xs">
                <div class="bg-green-50 border border-green-100 rounded-xl p-3 text-left">
                  <p class="text-gray-500 mb-1">📊 Pending (in stakes)</p>
                  <p class="font-bold text-green-700 text-sm" id="pendingInStakes">0.0000 LRX</p>
                  <p class="text-gray-400 text-xs mt-1">Grows daily from all active stakes</p>
                </div>
                <div class="bg-blue-50 border border-blue-100 rounded-xl p-3 text-left">
                  <p class="text-gray-500 mb-1">🏦 Stored Balance</p>
                  <p class="font-bold text-blue-700 text-sm" id="storedBalance">0.0000 LRX</p>
                  <p class="text-gray-400 text-xs mt-1">Previously claimed, ready to send</p>
                </div>
              </div>
            </div>

            <!-- How it works -->
            <div class="bg-white border border-green-200 rounded-xl p-4 mb-4 text-xs text-gray-700 space-y-2">
              <p class="font-bold text-green-700 mb-2"><i class="fas fa-info-circle mr-1"></i>How Your Growth Works</p>
              <div class="flex items-start gap-2"><span class="text-green-500 font-bold">1</span><p><strong>Stake LRX today</strong> — growth begins from the <strong>next day (Day 2)</strong> onward</p></div>
              <div class="flex items-start gap-2"><span class="text-green-500 font-bold">2</span><p>Every day, <strong>1.33% of your staked amount</strong> is added to your pending growth</p></div>
              <div class="flex items-start gap-2"><span class="text-green-500 font-bold">3</span><p>Growth from <strong>all your stakes is combined</strong> into one total balance shown above</p></div>
              <div class="flex items-start gap-2"><span class="text-green-500 font-bold">4</span><p>When total reaches <strong>100 LRX</strong>, press the button below to send it all to your wallet</p></div>
            </div>

            <!-- THE SINGLE WITHDRAW BUTTON -->
            <button onclick="doWithdrawAllGrowth()" id="withdrawAllBtn"
              class="withdraw-btn w-full text-white font-bold py-4 rounded-xl transition text-base disabled:opacity-60">
              <i class="fas fa-arrow-circle-down mr-2"></i>
              Withdraw All Growth to My Wallet
            </button>
            <p id="withdrawStatusMsg" class="text-xs text-center mt-2 font-medium"></p>
          </div>

          <!-- CREATE STAKE CARD -->
          <div class="bg-white rounded-2xl shadow-xl p-5 glass-card border-2 border-purple-200">
            <h3 class="text-lg font-bold mb-2"><i class="fas fa-rocket text-purple-500 mr-2"></i>Create New Stake</h3>
            <div class="bg-gradient-to-r from-green-600 to-green-700 rounded-xl p-2 mb-3 text-center text-white text-sm">
              1.33% Daily &bull; 150 Days Lock &bull; Total ROI: 199.50%
            </div>
            <div class="space-y-3">
              <div>
                <label class="block text-sm font-semibold mb-1">Amount (LRX) <span class="text-xs text-gray-400">Min 100 | Max 50,000</span></label>
                <input id="stakeAmt" type="number" step="0.01" min="100" max="50000" placeholder="Enter LRX amount" oninput="calcStake()"
                  class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-purple-300 outline-none"/>
              </div>
              <div>
                <label class="block text-sm font-semibold mb-1">Referrer Address <span class="text-xs text-gray-400">(optional)</span></label>
                <input id="refAddr" type="text" placeholder="0x..."
                  class="w-full border border-gray-200 rounded-xl p-3 font-mono text-sm outline-none focus:ring-2 focus:ring-purple-300"/>
              </div>
              <div class="bg-gray-900 rounded-xl p-3 text-white text-sm">
                <p class="text-gray-400 text-xs mb-2"><i class="fas fa-calculator mr-1"></i>Returns Calculator</p>
                <div class="grid grid-cols-2 gap-2">
                  <div class="bg-white/10 rounded-lg p-2"><p class="text-xs text-gray-400">Daily Return</p><p class="font-bold text-green-300" id="calcDaily">0.0000 LRX</p></div>
                  <div class="bg-white/10 rounded-lg p-2"><p class="text-xs text-gray-400">Total Reward (150d)</p><p class="font-bold text-yellow-300" id="calcTotal">0.0000 LRX</p></div>
                  <div class="bg-white/10 rounded-lg p-2"><p class="text-xs text-gray-400">Total You Receive</p><p class="font-bold text-blue-300" id="calcReceive">0.0000 LRX</p></div>
                  <div class="bg-white/10 rounded-lg p-2"><p class="text-xs text-gray-400">Lock Period</p><p class="font-bold">150 Days</p></div>
                </div>
              </div>
              <button onclick="doStake()" id="stakeBtn"
                class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold py-3 rounded-xl hover:opacity-90 transition">
                <i class="fas fa-rocket mr-2"></i>STAKE LRX NOW
              </button>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="space-y-6">

          <!-- STAKING SUMMARY -->
          <div class="bg-white rounded-2xl shadow-xl p-5 glass-card">
            <h3 class="text-lg font-bold mb-3"><i class="fas fa-chart-line text-blue-500 mr-2"></i>Staking Summary</h3>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between p-3 bg-purple-50 rounded-xl">
                <span class="text-gray-600">💰 Total Principal Staked</span>
                <span class="font-bold text-purple-600" id="totalPrincipalStaked">0.00 LRX</span>
              </div>
              <div class="flex justify-between p-3 bg-green-50 rounded-xl">
                <span class="text-gray-600">🌱 Pending Growth (all stakes)</span>
                <span class="font-bold text-green-600" id="totalPendingDetail">0.00 LRX</span>
              </div>
              <div class="flex justify-between p-3 bg-blue-50 rounded-xl">
                <span class="text-gray-600">🏦 Stored Growth Balance</span>
                <span class="font-bold text-blue-600" id="storedGrowthDisplay">0.00 LRX</span>
              </div>
              <div class="flex justify-between p-3 bg-amber-50 rounded-xl">
                <span class="text-gray-600">📈 Daily Growth Rate</span>
                <span class="font-bold text-amber-600" id="dailyRateDetail">0.00 LRX/day</span>
              </div>
              <div class="flex justify-between p-3 bg-emerald-50 rounded-xl">
                <span class="text-gray-600">📊 Total Ever Withdrawn</span>
                <span class="font-bold text-emerald-600" id="totalClaimedRewards">0.00 LRX</span>
              </div>
            </div>
          </div>

          <!-- REFERRAL INCOME -->
          <div class="bg-white rounded-2xl shadow-xl p-5 glass-card">
            <h3 class="text-lg font-bold mb-2"><i class="fas fa-hand-holding-usd text-amber-500 mr-2"></i>Referral Income</h3>
            <p class="text-xs text-gray-500 mb-3">Withdraw referral &amp; level income (min 100 LRX, max 50,000 LRX).</p>
            <div class="bg-amber-50 rounded-xl p-3 mb-3">
              <div class="grid grid-cols-2 gap-2 text-sm">
                <div><p class="text-xs text-gray-500">Referral Balance</p><p class="font-bold text-amber-600" id="refBalDetail">0.00 LRX</p></div>
                <div><p class="text-xs text-gray-500">Total Earned</p><p class="font-bold text-green-600" id="totalLevelInc">0.00 LRX</p></div>
              </div>
            </div>
            <div class="space-y-2 text-sm mb-3">
              <div class="flex justify-between p-2 bg-gray-50 rounded-lg"><span>Level 1 (5%)</span><span class="font-bold text-blue-600" id="l1inc">0.00 LRX</span></div>
              <div class="flex justify-between p-2 bg-gray-50 rounded-lg"><span>Level 2 (5%)</span><span class="font-bold text-indigo-600" id="l2inc">0.00 LRX</span></div>
              <div class="flex justify-between p-2 bg-gray-50 rounded-lg"><span>Level 3 (3%)</span><span class="font-bold text-purple-600" id="l3inc">0.00 LRX</span></div>
              <div class="flex justify-between p-2 bg-gray-50 rounded-lg"><span>Level 4 (3%)</span><span class="font-bold text-pink-600" id="l4inc">0.00 LRX</span></div>
            </div>
            <button onclick="doWithdrawReferral()" id="withdrawRefBtn"
              class="w-full bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold py-3 rounded-xl hover:opacity-90 transition">
              <i class="fas fa-arrow-down mr-2"></i>Withdraw Referral Income
            </button>
          </div>

          <!-- REFERRAL LINK -->
          <div class="bg-white rounded-2xl shadow-xl p-5 glass-card">
            <h3 class="text-lg font-bold mb-2"><i class="fas fa-link text-amber-500 mr-2"></i>Your Referral Link</h3>
            <p class="text-sm text-gray-500 mb-2">L1: 5% | L2: 5% | L3: 3% | L4: 3% — paid instantly on stake</p>
            <div id="refLinkBox" onclick="copyRefLink()"
              class="bg-gray-100 p-3 rounded-xl text-xs md:text-sm font-mono break-all cursor-pointer hover:bg-gray-200 transition text-center">
              Connect wallet to get your referral link
            </div>
            <p class="text-xs text-gray-400 mt-2 text-center"><i class="far fa-copy mr-1"></i>Click to copy</p>
          </div>

          <!-- UNSTAKE -->
          <div class="bg-white rounded-2xl shadow-xl p-5 glass-card border-2 border-red-100">
            <h3 class="text-lg font-bold mb-2"><i class="fas fa-unlock text-red-500 mr-2"></i>Unstake Principal</h3>
            <p class="text-xs text-gray-500 mb-3">Available after 150 days. Any pending growth is auto-saved to your stored balance before returning principal.</p>
            <div class="mb-3">
              <label class="block text-sm font-semibold mb-1">Select Stake to Unstake</label>
              <select id="unstakeStakeId" class="w-full border border-gray-200 rounded-xl p-3 outline-none">
                <option value="">-- Select stake --</option>
              </select>
            </div>
            <button onclick="doUnstake()" id="unstakeBtn"
              class="w-full bg-gradient-to-r from-red-500 to-rose-600 text-white font-bold py-3 rounded-xl hover:opacity-90 transition">
              <i class="fas fa-lock-open mr-2"></i>Unstake Principal
            </button>
          </div>

          <!-- CONTRACT INFO -->
          <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl shadow-xl p-5 border border-indigo-200">
            <h3 class="text-lg font-bold mb-3"><i class="fas fa-shield-alt text-indigo-600 mr-2"></i>Contract Info</h3>
            <div class="space-y-2">
              <div class="bg-white/70 rounded-xl p-3">
                <p class="text-xs text-gray-500 mb-1">Staking Contract (Polygon)</p>
                <p class="font-mono text-xs break-all text-gray-800">0x6530c53B10E49cbf76a59aB60A1170b91D1Bd02D</p>
              </div>
              <div class="bg-white/70 rounded-xl p-3">
                <p class="text-xs text-gray-500 mb-1">LRX Token (Polygon)</p>
                <p class="font-mono text-xs break-all text-gray-800">0x5329F10De5dDB998125E3526c3281730AD4300e0</p>
              </div>
              <a href="https://polygonscan.com/address/0x6530c53B10E49cbf76a59aB60A1170b91D1Bd02D"
                 target="_blank" rel="noopener noreferrer"
                 class="flex items-center justify-center gap-2 w-full bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold py-3 rounded-xl hover:opacity-90 transition mt-2">
                <i class="fas fa-external-link-alt"></i> View Contract on PolygonScan
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- MY STAKES TABLE -->
      <div class="mt-6 bg-white rounded-2xl shadow-xl overflow-hidden">
        <div class="bg-gradient-to-r from-indigo-50 to-purple-50 px-4 md:px-6 py-4 border-b">
          <h3 class="font-bold text-base md:text-lg"><i class="fas fa-table-list text-indigo-600 mr-2"></i>My Staking Positions</h3>
          <p class="text-xs text-gray-500">Growth starts Day 2 after staking &bull; All growth combines into one withdrawal balance above</p>
        </div>
        <div class="overflow-x-auto p-4">
          <table class="w-full text-xs md:text-sm">
            <thead class="bg-gray-100">
              <tr>
                <th class="p-2 text-left">#</th>
                <th class="p-2 text-left">Staked</th>
                <th class="p-2 text-left">Start Date</th>
                <th class="p-2 text-left">Unlock Date</th>
                <th class="p-2 text-left">Days Left</th>
                <th class="p-2 text-left">Daily Growth</th>
                <th class="p-2 text-left">Pending Growth</th>
                <th class="p-2 text-left">Ever Claimed</th>
                <th class="p-2 text-left">Status</th>
              </tr>
            </thead>
            <tbody id="stakesBody">
              <tr><td colspan="9" class="text-center p-6 text-gray-400">Connect wallet to view stakes</td></tr>
            </tbody>
          </table>
        </div>
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 px-4 py-3 border-t flex flex-wrap gap-6 text-sm">
          <span class="text-gray-600">Combined daily growth: <strong class="text-green-700" id="footerDailyTotal">0.0000 LRX/day</strong></span>
          <span class="text-gray-600">Total pending across all stakes: <strong class="text-green-700" id="footerPendingTotal">0.0000 LRX</strong></span>
        </div>
      </div>
    </div>

    <!-- HISTORY TAB -->
    <div id="historyTab" class="hidden fade-in">
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 px-4 md:px-6 py-4 border-b">
          <h3 class="font-bold text-base md:text-lg"><i class="fas fa-history text-blue-600 mr-2"></i>Withdrawal History</h3>
        </div>
        <div class="overflow-x-auto p-4">
          <table class="w-full text-xs md:text-sm">
            <thead class="bg-gray-100">
              <tr>
                <th class="p-3 text-left">Date</th>
                <th class="p-3 text-left">Type</th>
                <th class="p-3 text-left">Amount</th>
                <th class="p-3 text-left">Tx Hash</th>
                <th class="p-3 text-left">Status</th>
              </tr>
            </thead>
            <tbody id="historyBody">
              <tr><td colspan="5" class="text-center p-6 text-gray-400">No withdrawal history yet</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="mt-8 pt-4 border-t border-gray-200 text-center text-xs text-gray-400 space-y-1">
    <p>Liberty Reserve &bull; LRX Staking Platform &bull; Powered by Polygon Network</p>
    <p>
