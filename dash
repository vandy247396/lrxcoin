<script>
// ============================================================
// LIBERTY RESERVE — LRX STAKING PLATFORM (FIXED VERSION)
// Contract: 0x6530c53B10E49cbf76a59aB60A1170b91D1Bd02D
// Network:  Polygon Mainnet
