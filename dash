const LRX_TOKEN    = "0x5329F10De5dDB998125E3526c3281730AD4300e0";
const STAKING_ADDR = "0x6530c53B10E49cbf76a59aB60A1170b91D1Bd02D";
const POLYGON_ID   = "0x89";
const RPC_URLS     = ["https://polygon-rpc.com", "https://rpc-mainnet.matic.network", "https://rpc-mainnet.matic.quiknode.pro"];

const STAKING_ABI = [
  "function stake(uint256 amount, address referrer) external",
  "function unstake(uint256 stakeId) external",
  "function claimGrowth(uint256 stakeId) external",
  "function withdrawGrowthBalance() external",
  "function withdrawReferralIncome() external",
  "function getStakes(address user) view returns (tuple(uint256 amount, uint256 startTime, uint256 lastClaim, uint256 totalClaimed, bool unstaked)[])",
  "function pendingReward(address user, uint256 stakeId) view returns (uint256)",
  "function growthBalance(address) view returns (uint256)",
  "function referralBalance(address) view returns (uint256)",
  "function getLevelIncome(address user) view returns (uint256, uint256, uint256, uint256, uint256)",
  "function poolBalance() view returns (uint256)",
  "function totalStaked() view returns (uint256)"
];

const ERC20_ABI = [
  "function balanceOf(address) view returns (uint256)",
  "function decimals() view returns (uint8)",
  "function approve(address, uint256) returns (bool)",
  "function allowance(address, address) view returns (uint256)"
];

let provider, signer, userAddr, lrxCon, stakeCon, decimals = 18;
let cachedStakes = [];
let refreshInterval = null;
let isRefreshing = false;

// ── Helpers ──────────────────────────────────────────────────

function toast(msg, type = "success") {
  const root  = document.getElementById("toastRoot");
  const color = type === "error" ? "bg-red-700" : type === "info" ? "bg-gray-800" : "bg-green-700";
  root.innerHTML = `<div class="${color} text-white px-5 py-3 rounded-full shadow-2xl text-sm toast-slide max-w-[90vw] text-center">${msg}</div>`;
  setTimeout(() => root.innerHTML = "", 4500);
}

function fmt(wei) {
  try { return parseFloat(ethers.utils.formatUnits(wei, decimals)).toFixed(4); }
  catch(e) { return "0.0000"; }
}

function fmtN(n) { return parseFloat(n || 0).toFixed(4); }
function short(addr) { return addr ? addr.slice(0,6) + "..." + addr.slice(-4) : "—"; }

async function setBtnLoading(id, loading) {
  const btn = document.getElementById(id);
  if (!btn) return;
  if (loading) {
    btn.dataset.orig = btn.innerHTML;
    btn.innerHTML = '<span class="loading-spinner mr-2"></span>Processing...';
    btn.disabled = true;
  } else {
    btn.innerHTML = btn.dataset.orig || btn.innerHTML;
    btn.disabled = false;
  }
}

// Fallback copy function for older browsers
async function copyToClipboard(text) {
  try {
    await navigator.clipboard.writeText(text);
    return true;
  } catch(e) {
    // Fallback for older browsers
    const textarea = document.createElement('textarea');
    textarea.value = text;
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    document.body.removeChild(textarea);
    return true;
  }
}

// ── Tab ───────────────────────────────────────────────────────

function showTab(tab) {
  const isStaking = tab === 'staking';
  document.getElementById('stakingTab').classList.toggle('hidden', !isStaking);
  document.getElementById('historyTab').classList.toggle('hidden', isStaking);
  document.getElementById('tabStakingBtn').className = (isStaking ? 'tab-active' : 'tab-inactive') + ' px-4 md:px-6 py-2 rounded-t-xl font-semibold transition-all whitespace-nowrap';
  document.getElementById('tabHistoryBtn').className = (!isStaking ? 'tab-active' : 'tab-inactive') + ' px-4 md:px-6 py-2 rounded-t-xl font-semibold transition-all whitespace-nowrap';
  
  if (!isStaking && userAddr) {
    loadWithdrawalHistory();
  }
}

// ── Load Withdrawal History (using local storage for demo) ───
// Note: Real implementation would query contract events
async function loadWithdrawalHistory() {
  const historyBody = document.getElementById("historyBody");
  
  // Try to load from localStorage first
  const savedHistory = localStorage.getItem(`lrx_withdrawals_${userAddr}`);
  
  if (savedHistory) {
    const withdrawals = JSON.parse(savedHistory);
    if (withdrawals.length > 0) {
      historyBody.innerHTML = withdrawals.map(w => `
        <tr class="border-b hover:bg-gray-50">
          <td class="p-3">${new Date(w.timestamp).toLocaleString()}</td>
          <td class="p-3"><span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">${w.type}</span></td>
          <td class="p-3 font-bold text-green-600">${w.amount} LRX</td>
          <td class="p-3"><a href="https://polygonscan.com/tx/${w.txHash}" target="_blank" class="text-blue-500 hover:underline">${short(w.txHash)}</a></td>
          <td class="p-3"><span class="text-green-600">✓ Success</span></td>
        </tr>
      `).join('');
      return;
    }
  }
  
  historyBody.innerHTML = '<tr><td colspan="5" class="text-center p-6 text-gray-400">No withdrawal history yet. Your withdrawals will appear here.</td></tr>';
}

// Save withdrawal to history
function saveWithdrawalToHistory(type, amount, txHash) {
  const key = `lrx_withdrawals_${userAddr}`;
  const existing = JSON.parse(localStorage.getItem(key) || '[]');
  existing.unshift({
    type: type,
    amount: amount,
    txHash: txHash,
    timestamp: Date.now()
  });
  // Keep only last 50 transactions
  if (existing.length > 50) existing.pop();
  localStorage.setItem(key, JSON.stringify(existing));
}

// ── Connect Wallet with retry logic ────────────────────────────

async function switchNetwork(chainId) {
  try {
    await window.ethereum.request({
      method: 'wallet_switchEthereumChain',
      params: [{ chainId: chainId }],
    });
    return true;
  } catch (switchError) {
    if (switchError.code === 4902) {
      try {
        await window.ethereum.request({
          method: 'wallet_addEthereumChain',
          params: [{
            chainId: chainId,
            chainName: "Polygon Mainnet",
            nativeCurrency: { name: "MATIC", symbol: "MATIC", decimals: 18 },
            rpcUrls: ["https://polygon-rpc.com"],
            blockExplorerUrls: ["https://polygonscan.com"]
          }]
        });
        return true;
      } catch(addError) {
        throw new Error("Failed to add Polygon network");
      }
    }
    throw switchError;
  }
}

async function connectWallet() {
  if (!window.ethereum) { toast("Please install MetaMask", "error"); return; }
  await setBtnLoading('connectBtn', true);
  
  try {
    await window.ethereum.request({ method: "eth_requestAccounts" });
    const chainId = await window.ethereum.request({ method: "eth_chainId" });
    
    if (chainId !== POLYGON_ID) {
      toast("Please switch to Polygon Mainnet", "info");
      await switchNetwork(POLYGON_ID);
    }

    // Create provider with fallback RPCs
    provider = new ethers.providers.Web3Provider(window.ethereum);
    signer = provider.getSigner();
    userAddr = await signer.getAddress();
    
    lrxCon = new ethers.Contract(LRX_TOKEN, ERC20_ABI, signer);
    stakeCon = new ethers.Contract(STAKING_ADDR, STAKING_ABI, signer);
    
    try { 
      decimals = await lrxCon.decimals(); 
    } catch(e) { 
      decimals = 18; 
    }

    const urlRef = new URLSearchParams(location.search).get("ref");
    if (urlRef && ethers.utils.isAddress(urlRef) && urlRef.toLowerCase() !== userAddr.toLowerCase()) {
      document.getElementById("refAddr").value = urlRef;
    }

    document.getElementById("refLinkBox").innerHTML = `<i class="fas fa-link mr-2"></i>${location.origin}${location.pathname}?ref=${userAddr}`;
    document.getElementById("walletAddr").textContent = short(userAddr);
    document.getElementById("dashboardPanel").classList.remove("hidden");
    document.getElementById("connectBtn").innerHTML = `<i class="fab fa-metamask mr-2"></i>${short(userAddr)}`;

    await refreshAll();
    
    // Clear existing interval if any
    if (refreshInterval) clearInterval(refreshInterval);
    // Set new interval (only when tab is visible for performance)
    refreshInterval = setInterval(() => {
      if (document.visibilityState === 'visible') {
        refreshAll();
      }
    }, 30000);
    
    window.ethereum.on("accountsChanged", () => location.reload());
    window.ethereum.on("chainChanged", () => location.reload());
    toast("Wallet connected!", "success");
  } catch(e) {
    console.error(e);
    toast(e.message || "Connection failed", "error");
  } finally {
    await setBtnLoading('connectBtn', false);
  }
}

// ── Refresh All with error handling ───────────────────────────────

async function refreshAll() {
  if (!userAddr || isRefreshing) return;
  isRefreshing = true;
  
  try {
    const [lrxBal, gBal, rBal, levelData] = await Promise.all([
      lrxCon.balanceOf(userAddr).catch(() => ethers.BigNumber.from(0)),
      stakeCon.growthBalance(userAddr).catch(() => ethers.BigNumber.from(0)),
      stakeCon.referralBalance(userAddr).catch(() => ethers.BigNumber.from(0)),
      stakeCon.getLevelIncome(userAddr).catch(() => [0,0,0,0,0])
    ]);

    const storedGrowth = parseFloat(fmt(gBal));

    document.getElementById("lrxBal").textContent = fmt(lrxBal);
    document.getElementById("storedBalance").textContent = fmtN(storedGrowth) + " LRX";
    document.getElementById("storedGrowthDisplay").textContent = fmtN(storedGrowth) + " LRX";
    document.getElementById("refBalDetail").textContent = fmt(rBal) + " LRX";

    if (Array.isArray(levelData)) {
      document.getElementById("l1inc").textContent = fmt(levelData[0]) + " LRX";
      document.getElementById("l2inc").textContent = fmt(levelData[1]) + " LRX";
      document.getElementById("l3inc").textContent = fmt(levelData[2]) + " LRX";
      document.getElementById("l4inc").textContent = fmt(levelData[3]) + " LRX";
      document.getElementById("totalLevelInc").textContent = fmt(levelData[4]) + " LRX";
    }

    await renderStakes(storedGrowth);
  } catch(e) { 
    console.error("Refresh error:", e);
    toast("Network error - retrying...", "info");
  } finally {
    isRefreshing = false;
  }
}

// ── Render Stakes Table ───────────────────────────────────────

async function renderStakes(storedGrowth = 0) {
  try {
    cachedStakes = await stakeCon.getStakes(userAddr).catch(() => []);

    const tbody = document.getElementById("stakesBody");
    const unstakeSel = document.getElementById("unstakeStakeId");

    let totalStaked = 0, totalPending = 0, totalDaily = 0, totalClaimed = 0;

    if (!cachedStakes || cachedStakes.length === 0) {
      tbody.innerHTML = '<tr><td colspan="9" class="text-center p-6 text-gray-400">No stakes yet — stake LRX to start earning!</td></tr>';
      unstakeSel.innerHTML = '<option value="">-- No stakes --</option>';
      updateGrowthUI(0, storedGrowth, 0, 0, 0);
      return;
    }

    let html = "", unstakeOpts = '<option value="">-- Select stake --</option>';
    const now = Math.floor(Date.now() / 1000);

    for (let i = 0; i < cachedStakes.length; i++) {
      const s = cachedStakes[i];
      const startTs = s.startTime.toNumber();
      const daysLeft = Math.max(0, Math.ceil((startTs + 150 * 86400 - now) / 86400));
      const staked = parseFloat(fmt(s.amount));
      const claimed = parseFloat(fmt(s.totalClaimed));
      const withdrawn = s.unstaked;
      const daysSince = (now - startTs) / 86400;

      let pending = 0;
      if (!withdrawn && daysSince >= 1) {
        try {
          const pendingWei = await stakeCon.pendingReward(userAddr, i);
          pending = parseFloat(fmt(pendingWei));
        } catch(e) {}
      }

      const daily = staked * 1.33 / 100;

      if (!withdrawn) {
        totalStaked += staked;
        totalPending += pending;
        totalDaily += daily;
        totalClaimed += claimed;
      }

      const pendingDisplay = withdrawn
        ? `<span class="text-gray-400">${fmtN(pending)} LRX</span>`
        : daysSince < 1
          ? `<span class="text-xs text-amber-500 font-medium">⏳ Starts tomorrow</span>`
          : `<span class="text-green-600 font-bold">${fmtN(pending)} LRX</span>`;

      const status = withdrawn
        ? '<span class="bg-gray-100 text-gray-500 px-2 py-1 rounded-full text-xs">Withdrawn</span>'
        : daysLeft === 0
          ? '<span class="bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-bold">✅ Matured</span>'
          : '<span class="bg-blue-100 text-blue-700 px-2 py-1 rounded-full text-xs">Active</span>';

      html += `<tr class="border-b hover:bg-gray-50">
        <td class="p-2 font-mono text-gray-500">${i}</td>
        <td class="p-2 font-bold text-purple-700">${fmtN(staked)} LRX</td>
        <td class="p-2 text-xs">${new Date(startTs * 1000).toLocaleDateString()}</td>
        <td class="p-2 text-xs">${new Date((startTs + 150 * 86400) * 1000).toLocaleDateString()}</td>
        <td class="p-2 text-xs">${daysLeft > 0 ? daysLeft + "d" : "Ready"}</td>
        <td class="p-2 text-amber-600 font-semibold">${fmtN(daily)} LRX</td>
        <td class="p-2">${pendingDisplay}</td>
        <td class="p-2 text-blue-600">${fmtN(claimed)} LRX</td>
        <td class="p-2">${status}</td>
      </tr>`;

      if (!withdrawn) {
        unstakeOpts += `<option value="${i}">Stake #${i} — ${fmtN(staked)} LRX${daysLeft === 0 ? " ✅ Ready" : " (" + daysLeft + "d left)"}</option>`;
      }
    }

    tbody.innerHTML = html;
    unstakeSel.innerHTML = unstakeOpts;

    updateGrowthUI(totalPending, storedGrowth, totalStaked, totalDaily, totalClaimed);

    document.getElementById("footerDailyTotal").textContent = fmtN(totalDaily) + " LRX/day";
    document.getElementById("footerPendingTotal").textContent = fmtN(totalPending) + " LRX";

  } catch(e) { 
    console.error("Render stakes error:", e);
  }
}

// ── Update Growth UI (the big card) ──────────────────────────

function updateGrowthUI(totalPending, storedGrowth, totalStaked, totalDaily, totalClaimed) {
  const totalAvailable = totalPending + storedGrowth;
  const pct = Math.min(100, (totalAvailable / 100) * 100);

  document.getElementById("bigGrowthNumber").textContent = fmtN(totalAvailable);
  document.getElementById("pendingInStakes").textContent = fmtN(totalPending) + " LRX";
  document.getElementById("progressBar").style.width = pct + "%";
  document.getElementById("progressPct").textContent = pct.toFixed(1) + "%";

  document.getElementById("totalStakedAmount").textContent = fmtN(totalStaked);
  document.getElementById("totalPendingGrowth").textContent = fmtN(totalAvailable);
  document.getElementById("dailyGrowthTotal").textContent = fmtN(totalDaily);

  document.getElementById("totalPrincipalStaked").textContent = fmtN(totalStaked) + " LRX";
  document.getElementById("totalPendingDetail").textContent = fmtN(totalPending) + " LRX";
  document.getElementById("dailyRateDetail").textContent = fmtN(totalDaily) + " LRX/day";
  document.getElementById("totalClaimedRewards").textContent = fmtN(totalClaimed) + " LRX";

  const btn = document.getElementById("withdrawAllBtn");
  const msg = document.getElementById("withdrawStatusMsg");

  if (totalAvailable < 100) {
    btn.disabled = true;
    const need = (100 - totalAvailable).toFixed(4);
    msg.innerHTML = `⏳ Need <strong>${need} more LRX</strong> to reach 100 LRX minimum. Growing daily!`;
    msg.style.color = "#f59e0b";
  } else {
    btn.disabled = false;
    msg.innerHTML = `✅ Ready! <strong>${fmtN(totalAvailable)} LRX</strong> will be sent to your wallet.`;
    msg.style.color = "#10b981";
  }
}

// ── MAIN ACTION: Withdraw All Growth (FIXED) ─────────────────────────
async function doWithdrawAllGrowth() {
  if (!signer) { toast("Connect wallet first", "error"); return; }

  const now = Math.floor(Date.now() / 1000);

  const eligible = [];
  for (let i = 0; i < cachedStakes.length; i++) {
    const s = cachedStakes[i];
    if (s.unstaked) continue;
    const daysSince = (now - s.startTime.toNumber()) / 86400;
    if (daysSince < 1) continue;
    try {
      const pendingWei = await stakeCon.pendingReward(userAddr, i);
      const amt = parseFloat(ethers.utils.formatUnits(pendingWei, decimals));
      if (amt > 0) eligible.push({ id: i, amount: amt });
    } catch(e) {}
  }

  const totalPending = eligible.reduce((s, e) => s + e.amount, 0);
  const gBalWei = await stakeCon.growthBalance(userAddr);
  const storedGrowth = parseFloat(ethers.utils.formatUnits(gBalWei, decimals));
  const totalAvail = totalPending + storedGrowth;

  if (totalAvail < 100) {
    toast(`Need 100 LRX minimum. You have ${fmtN(totalAvail)} LRX total.`, "error");
    return;
  }

  const txCount = eligible.length + 1;
  const ok = confirm(
    `💸 Withdraw All Growth to Wallet\n\n` +
    `Pending from ${eligible.length} stake(s): ${fmtN(totalPending)} LRX\n` +
    `Stored balance:                ${fmtN(storedGrowth)} LRX\n` +
    `────────────────────────────────\n` +
    `Total to your wallet:          ${fmtN(totalAvail)} LRX\n\n` +
    `This requires ${txCount} transaction(s). Continue?`
  );
  if (!ok) return;

  await setBtnLoading('withdrawAllBtn', true);

  try {
    if (eligible.length > 0) {
      toast(`Collecting growth from ${eligible.length} stake(s)...`, "info");
      for (let idx = 0; idx < eligible.length; idx++) {
        const stake = eligible[idx];
        try {
          const tx = await stakeCon.claimGrowth(stake.id);
          await tx.wait();
          toast(`✅ Collected ${fmtN(stake.amount)} LRX from Stake #${stake.id} (${idx+1}/${eligible.length})`, "success");
          if (idx < eligible.length - 1) await new Promise(r => setTimeout(r, 1500));
        } catch(e) {
          console.error(`Claim #${stake.id} failed:`, e);
          toast(`⚠️ Skipped Stake #${stake.id} — continuing`, "info");
        }
      }
    }

    const finalBalWei = await stakeCon.growthBalance(userAddr);
    const finalBal = parseFloat(ethers.utils.formatUnits(finalBalWei, decimals));

    if (finalBal < 100) {
      toast(`Stored balance (${fmtN(finalBal)} LRX) still below 100 LRX minimum.`, "error");
      return;
    }

    toast(`Sending ${fmtN(finalBal)} LRX to your wallet...`, "info");
    const withdrawTx = await stakeCon.withdrawGrowthBalance();
    await withdrawTx.wait();
    
    // Save to history
    saveWithdrawalToHistory("Growth Withdrawal", fmtN(finalBal), withdrawTx.hash);
    
    toast(`🎉 ${fmtN(finalBal)} LRX sent to your wallet!`, "success");
    await refreshAll();
    
    // Refresh history if tab is open
    if (document.getElementById('historyTab').classList.contains('fade-in')) {
      loadWithdrawalHistory();
    }

  } catch(e) {
    console.error(e);
    toast(e.reason || e.message || "Withdrawal failed", "error");
  } finally {
    await setBtnLoading('withdrawAllBtn', false);
  }
}

// ── Stake (FIXED - secure approval) ─────────────────────────────────────

async function doStake() {
  if (!signer) { toast("Connect wallet", "error"); return; }
  
  const amount = parseFloat(document.getElementById("stakeAmt").value);
  
  // Enhanced validation
  if (isNaN(amount) || amount < 100) { toast("Minimum stake is 100 LRX", "error"); return; }
  if (amount > 50000) { toast("Maximum stake is 50,000 LRX", "error"); return; }
  if (amount <= 0) { toast("Amount must be greater than 0", "error"); return; }

  const refRaw = document.getElementById("refAddr").value.trim();
  const ref = (refRaw && ethers.utils.isAddress(refRaw) && refRaw.toLowerCase() !== userAddr.toLowerCase())
    ? refRaw : ethers.constants.AddressZero;

  await setBtnLoading('stakeBtn', true);
  
  try {
    const amtWei = ethers.utils.parseUnits(amount.toString(), decimals);
    const allowance = await lrxCon.allowance(userAddr, STAKING_ADDR);
    
    // Only approve the exact amount needed (SECURITY FIX)
    if (allowance.lt(amtWei)) {
      toast("Approving LRX...", "info");
      const appTx = await lrxCon.approve(STAKING_ADDR, amtWei);
      await appTx.wait();
      toast("Approved!", "success");
    }
    
    toast("Staking...", "info");
    const tx = await stakeCon.stake(amtWei, ref);
    await tx.wait();
    
    toast(`✅ Staked ${amount} LRX! Growth begins tomorrow.`, "success");
    document.getElementById("stakeAmt").value = "";
    calcStake();
    await refreshAll();
  } catch(e) {
    console.error(e);
    toast(e.reason || e.message || "Stake failed", "error");
  } finally {
    await setBtnLoading('stakeBtn', false);
  }
}

