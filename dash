// ── Unstake ───────────────────────────────────────────────────

async function doUnstake() {
  if (!signer) { toast("Connect wallet", "error"); return; }
  
  const id = document.getElementById("unstakeStakeId").value;
  if (id === "") { toast("Please select a stake", "error"); return; }
  
  const selectedStake = cachedStakes[parseInt(id)];
  if (!selectedStake) { toast("Invalid stake selected", "error"); return; }
  
  const now = Math.floor(Date.now() / 1000);
  const startTs = selectedStake.startTime.toNumber();
  const daysLeft = Math.ceil((startTs + 150 * 86400 - now) / 86400);
  
  if (daysLeft > 0) {
    toast(`Stake #${id} is locked for ${daysLeft} more days`, "error");
    return;
  }
  
  if (!confirm(`Unstake position #${id}?\n\nYour principal will be returned to your wallet.\nAny pending growth will be saved to your stored balance first.`)) return;

  await setBtnLoading('unstakeBtn', true);
  
  try {
    toast("Processing unstake...", "info");
    const tx = await stakeCon.unstake(parseInt(id));
    await tx.wait();
    toast("✅ Principal returned to your wallet!", "success");
    await refreshAll();
  } catch(e) {
    console.error(e);
    toast(e.reason || e.message || "Unstake failed", "error");
  } finally {
    await setBtnLoading('unstakeBtn', false);
  }
}

// ── Calculator ────────────────────────────────────────────────

function calcStake() {
  const amt = parseFloat(document.getElementById("stakeAmt").value) || 0;
  const daily = amt * 1.33 / 100;
  const total = daily * 150;
  document.getElementById("calcDaily").textContent = fmtN(daily) + " LRX";
  document.getElementById("calcTotal").textContent = fmtN(total) + " LRX";
  document.getElementById("calcReceive").textContent = fmtN(amt + total) + " LRX";
}

// ── Copy Referral with fallback ─────────────────────────────────────────────

async function copyRefLink() {
  if (!userAddr) { toast("Connect wallet first", "error"); return; }
  
  const link = `${location.origin}${location.pathname}?ref=${userAddr}`;
  const success = await copyToClipboard(link);
  
  if (success) {
    toast("Referral link copied!", "success");
  } else {
    toast("Could not copy — please copy manually", "error");
  }
}

// ── Visibility API for better performance ──────────────────────

document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible' && userAddr) {
    refreshAll();
  }
});

// ── Init ──────────────────────────────────────────────────────

window.addEventListener("DOMContentLoaded", () => {
  calcStake();
  const urlRef = new URLSearchParams(location.search).get("ref");
  if (urlRef && /^0x[a-fA-F0-9]{40}$/.test(urlRef)) {
    document.getElementById("refAddr").value = urlRef;
  }
  
  // Check if wallet was previously connected
  if (window.ethereum && window.ethereum.selectedAddress) {
    connectWallet();
  }
});

// Cleanup interval on page unload
window.addEventListener('beforeunload', () => {
  if (refreshInterval) clearInterval(refreshInterval);
});
</script>
</body>
</html>
